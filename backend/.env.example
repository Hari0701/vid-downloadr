# All values are optional; these are the defaults.
DOWNLOAD_DIR=/data/downloads
FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILESIZE_MB=2048
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_GENERIC_SOURCE=true

# Hosted deployments usually need one of these, because platforms block
# datacenter IPs and bot-check cloud traffic.
# PROXY=http://user:pass@host:port
# COOKIES_FILE=/data/cookies.txt

# Optional operator-supplied Instagram session (create offline with
# `instaloader --login=<user>`). Visitors are never asked for credentials.
# INSTAGRAM_USERNAME=
# INSTAGRAM_SESSION_FILE=/data/instagram.session
